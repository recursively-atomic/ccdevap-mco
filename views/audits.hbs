{{> navigation}}

<div class="container mt-5 mb-5">
    <div class="d-flex card shadow-lg">
        <div class="card-header text-center text-white bg-primary-accent">
            <h2 class="mt-2"> Audit Management </h2>
        </div>

        <!-- TABLE -->
        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover text-center">
                    <thead class="border-dark border-2">
                        <tr class="">
                            <th class="text-secondary bg-dark w-25" scope="col">
                                Timestamp
                            </th>

                            <th class="text-secondary bg-dark w-auto" scope="col">
                                Username
                            </th>


                            <th class="text-secondary bg-dark" scope="col">
                                User Role
                            </th>

                            <th class="text-secondary bg-dark" scope="col">
                                Activity
                            </th>
                        </tr>
                    </thead>

                    <tbody class="table-group-divider">
                        {{> auditRows}}

                        <tr class="border-3 border-bottom-0 border-end-0 border-start-0 border-dark"></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-primary-accent">
            <div class="d-flex flex-wrap gap-3 m-3 justify-content-between align-items-center">
                <h6 class="text-white">
                    Showing {{pagination.resultsPerPage}} Results Out Of {{pagination.totalResults}}
                </h6>

                <div class="d-flex flex-wrap gap-3 justify-content-center align-items-center">
                    {{> pagination}}
                </div>
            </div>
        </div>
    </div>
</div>

{{> footer}}