<img src="https://picsum.photos/1920/1080/?blur=5"
     class="position-fixed top-0 start-0 w-100 h-100 z-n1 object-fit-cover">

<div class="container m-auto">
    <div class="row justify-content-center">
        <div class="col-10 col-sm-9 col-md-7 col-lg-4">
            <div class="p-4 mt-5 mb-5 card shadow-sm rounded-3 bg-dark">
                <img class="d-inline-block mb-2 p-1 align-items-center square-40px"
                     src="/media/images/cebu-atlantic.png">

                <h2 class="mb-4 text-center fw-bolder text-primary"> Log In </h2>

                <form onsubmit="checkCredentials(event, 'login')">
                    <div class="mb-3">
                        <h4 class="text-secondary"> E-Mail Address </h4>

                        <div class="input-group">
                            <input name="email-address"
                                   class="form-control bg-light border-secondary border-2 text-black h-45px"
                                   type="email" placeholder="Enter Your Email" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <h4 class="text-secondary"> Password </h4>

                        <div class="input-group">
                            <input id="password" name="password"
                                   class="form-control bg-light border-secondary border-2 text-black h-45px"
                                   type="password" placeholder="Enter Your Password" required>

                            <button id="toggle-password" type="button"
                                    class="input-group-text bg-secondary border-secondary border-2">
                                <i id="toggle-icon" class="text-primary-accent fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="mt-3 btn btn-lg btn-secondary fw-bold text-light w-100">
                        Login
                    </button>

                    <div class="mt-3 text-center">
                        <a href="/register" class="text-decoration-none text-tertiary">
                            No Account? Register One!
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{{> toasts}}