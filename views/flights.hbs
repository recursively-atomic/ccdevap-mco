{{> navigation}}

<div id="flights-card" class="container mt-5 mb-5">
    {{> flightsCard}}
</div>

<!-- ADD FLIGHT MODAL -->
<div id="add-flight" class="modal fade" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered text-center">
        <div class="modal-content">
            <form onsubmit="createFlight(event)">
                <div class="modal-header bg-dark text-white">
                    <h2 class="modal-title fs-5 fw-bold">
                        Add A Flight
                    </h2>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-6">
                            <!-- AIRLINE -->
                            <h6 class="text-primary-accent text-start"> Airline
                                <span class="text-danger fw-bolder"> * </span>
                            </h6>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fa-solid fa-flag"></i>
                                </div>

                                <select id="airline" name="airline"
                                        class="form-select bg-light border-dark border-2 text-black required-field rounded-end-3"
                                        data-group="add-flight">
                                    <option selected hidden value=""> Select Airline </option>
                                    <option> Cebu Atlantic </option>
                                    <option> Filipino Airlines </option>
                                    <option> AirFAST </option>
                                    <option> Sunray Air </option>
                                </select>

                                <div class="invalid-feedback text-start">
                                    This airline field is required!
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <!-- BASE FARE -->
                            <h6 class="text-primary-accent text-start"> Base Fare
                                <span class="text-danger fw-bolder"> * </span>
                            </h6>

                            <div class="mb-2 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fw-bolder fst-normal"> PHP </i>
                                </div>

                                <input id="base-fare" name="base-fare"
                                       class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                                       data-group="add-flight" type="text" placeholder="Enter Base Fare">

                                <div class="invalid-feedback text-start">
                                    This base fare field is required!
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- AIRPORT ORIGIN -->
                    <h6 class="text-primary-accent text-start"> Airport Origin
                        <span class="text-danger fw-bolder"> * </span>
                    </h6>

                    <div class="mb-3 input-group">
                        <div class="input-group-text bg-dark border-dark">
                            <i class="text-secondary fa-solid fa-plane-departure"></i>
                        </div>

                        <input id="origin-iata" name="origin-iata"
                               class="form-control bg-light border-dark border-2 text-black required-field" type="text"
                               placeholder="Enter IATA Code" data-group="add-flight">
                        <input id="origin-location" name="origin-location"
                               class="form-control bg-light border-dark border-2 text-black required-field" type="text"
                               placeholder="Enter Locality" data-group="add-flight">
                        <input id="origin-name" name="origin-name"
                               class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                               type="text" placeholder="Enter Full Name" data-group="add-flight">

                        <div class="invalid-feedback text-start">
                            This airport origin field is required!
                        </div>
                    </div>

                    <!-- AIRPORT DESTINATION -->
                    <h6 class="text-primary-accent text-start"> Airport Destination
                        <span class="text-danger fw-bolder"> * </span>
                    </h6>

                    <div class="mb-3 input-group">
                        <div class="input-group-text bg-dark border-dark">
                            <i class="text-secondary fa-solid fa-plane-arrival"></i>
                        </div>

                        <input id="destination-iata" name="destination-iata"
                               class="form-control bg-light border-dark border-2 text-black required-field" type="text"
                               placeholder="Enter IATA Code" data-group="add-flight">
                        <input id="destination-location" name="destination-location"
                               class="form-control bg-light border-dark border-2 text-black required-field" type="text"
                               placeholder="Enter Locality" data-group="add-flight">
                        <input id="destination-name" name="destination-name"
                               class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                               type="text" placeholder="Enter Full Name" data-group="add-flight">

                        <div class="invalid-feedback text-start">
                            This airport destination field is required!
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-6">
                            <!-- DEPARTURE DATETIME -->
                            <h6 class="text-primary-accent text-start"> Departure Datetime
                                <span class="text-danger fw-bolder"> * </span>
                            </h6>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fa-solid fa-clock"></i>
                                </div>

                                <input id="departure-datetime" name="departure-datetime"
                                       class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                                       type="datetime-local" data-group="add-flight">

                                <div class="invalid-feedback text-start">
                                    This departure datetime field is required!
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <!-- ARRIVAL DATETIME -->
                            <h6 class="text-primary-accent text-start"> Arrival Datetime
                                <span class="text-danger fw-bolder"> * </span>
                            </h6>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fa-solid fa-clock"></i>
                                </div>

                                <input id="arrival-datetime" name="arrival-datetime"
                                       class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                                       type="datetime-local" data-group="add-flight">

                                <div class="invalid-feedback text-start">
                                    This arrival datetime field is required!
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex modal-footer bg-light">
                    <button class="btn btn-success text-white" type="submit">
                        Add
                    </button>

                    <button class="btn btn-danger text-white" data-bs-dismiss="modal" type="reset">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- VIEW FLIGHT MODAL -->
<div id="view-flight" class="modal fade" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h2 class="modal-title fs-5 fw-bold"></h2>
            </div>

            <div class="modal-body">
                <div class="d-flex m-0 align-items-center text-primary justify-content-between">
                    <h2 id="flight-number" class="mb-0 me-2"></h2>
                    <h2 id="flight-fare" class="m-0 p-0 ps-3 text-success text-end text-nowrap"></h2>
                </div>

                <hr class="border border-3 rounded-3 border-dark opacity-100">

                <div class="row gap-3">
                    <!-- FLIGHT DEPARTURE DETAILS -->
                    <div class="col">
                        <div class="d-flex m-0 p-0 align-items-center text-secondary">
                            <i class="fa-solid fa-plane-departure fa-xl"></i>
                            <h6 class="m-2 fw-bolder"> Departure </h6>
                        </div>

                        <div class="d-flex m-0 p-0 align-items-center text-primary-accent fw-bolder">
                            <p id="departure-iata" class="m-0 p-0 ps-3 mb"></p>
                            <i class="m-0 p-0 bi bi-dot mb"></i>
                            <p id="departure-location" class="m-0 p-0"></p>
                        </div>

                        <p id="departure-name" class="m-0 p-0 ps-4 text-dark"></p>
                        <p id="departure-day" class="m-0 p-0 ps-3 text-primary-accent fw-bolder"></p>
                        <p id="departure-time" class="m-0 p-0 ps-3 text-primary-accent fw-bolder"></p>
                    </div>

                    <!-- FLIGHT ARRIVAL DETAILS -->
                    <div class="col">
                        <div class="d-flex m-0 p-0 align-items-center text-secondary">
                            <i class="fa-solid fa-plane-arrival fa-xl"></i>
                            <h6 class="m-2 fw-bolder"> Arrival </h6>
                        </div>

                        <div class="d-flex m-0 p-0 align-items-center text-primary-accent fw-bolder">
                            <p id="arrival-iata" class="mb-auto m-0 p-0 ps-3"></p>
                            <i class="m-0 p-0 mb-auto bi bi-dot"></i>
                            <p id="arrival-location" class="m-0 p-0"></p>
                        </div>

                        <p id="arrival-name" class="m-0 p-0 ps-4 text-dark"></p>
                        <p id="arrival-day" class="m-0 p-0 ps-3 text-primary-accent fw-bolder"></p>
                        <p id="arrival-time" class="m-0 p-0 ps-3 text-primary-accent fw-bolder"></p>
                    </div>
                </div>

                <hr class="border border-3 rounded-3 border-dark opacity-100">

                <div class="d-flex gap-3 justify-content-center fs-5">
                    <span id="status-badge" class="p-2 badge rounded-pill text-white"></span>
                    <span id="capacity-badge" class="p-2 badge rounded-pill text-white"></span>
                    <span id="duration-badge" class="p-2 badge text-bg-primary rounded-pill text-white"></span>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button class="btn btn-primary text-white" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT FLIGHT MODAL -->
<div id="edit-flight" class="modal fade" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered text-center">
        <div class="modal-content">
            <form onsubmit="updateFlight(event)">
                <div class="modal-header bg-dark text-white">
                    <h2 class="modal-title fs-5 fw-bold"></h2>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-6">
                            <!-- BASE FARE -->
                            <h6 class="text-primary-accent text-start"> Base Fare
                                <span class="text-danger fw-bolder"> * </span>
                            </h6>

                            <div class="mb-2 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fw-bolder fst-normal"> PHP </i>
                                </div>

                                <input id="edit-fare" name="edit-fare"
                                       class="form-control bg-light border-dark border-2 text-black rounded-end-3 required-field"
                                       type="text" placeholder="Enter Base Fare" data-group="edit-flight">

                                <div class="invalid-feedback text-start">
                                    This base fare field is required!
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <!-- FLIGHT STATUS -->
                            <h6 class="text-primary-accent text-start"> Flight Status
                                <span class="text-danger fw-bolder"> * </span>
                            </h6>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fa-solid fa-flag"></i>
                                </div>

                                <select id="edit-status" name="edit-status"
                                        class="form-select bg-light border-dark border-2 text-black rounded-end-3 required-field"
                                        data-group="edit-flight">
                                    <option selected hidden value=""> Select Status </option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- AIRPORT ORIGIN -->
                    <h6 class="text-primary-accent text-start"> Airport Origin
                        <span class="text-danger fw-bolder"> * </span>
                    </h6>

                    <div class="mb-3 input-group">
                        <div class="input-group-text bg-dark border-dark">
                            <i class="text-secondary fa-solid fa-plane-departure"></i>
                        </div>

                        <input id="edit-o-iata" name="edit-o-iata"
                               class="form-control bg-light border-dark border-2 text-black required-field" type="text"
                               placeholder="Enter IATA Code" data-group="edit-flight">
                        <input id="edit-o-location" name="edit-o-location"
                               class="form-control bg-light border-dark border-2 text-black required-field" type="text"
                               placeholder="Enter Locality" data-group="edit-flight">
                        <input id="edit-o-name" name="edit-o-name"
                               class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                               type="text" placeholder="Enter Full Name" data-group="edit-flight">

                        <div class="invalid-feedback text-start">
                            This airport origin field is required!
                        </div>
                    </div>

                    <!-- AIRPORT DESTINATION -->
                    <h6 class="text-primary-accent text-start"> Airport Destination
                        <span class="text-danger fw-bolder"> * </span>
                    </h6>

                    <div class="mb-3 input-group">
                        <div class="input-group-text bg-dark border-dark">
                            <i class="text-secondary fa-solid fa-plane-arrival"></i>
                        </div>

                        <input id="edit-d-iata" name="edit-d-iata"
                               class="form-control bg-light border-dark border-2 text-black required-field" type="text"
                               placeholder="Enter IATA Code" data-group="edit-flight">
                        <input id="edit-d-location" name="edit-d-location"
                               class="form-control bg-light border-dark border-2 text-black required-field" type="text"
                               placeholder="Enter Locality" data-group="edit-flight">
                        <input id="edit-d-name" name="edit-d-name"
                               class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                               type="text" placeholder="Enter Full Name" data-group="edit-flight">

                        <div class="invalid-feedback text-start">
                            This airport destination field is required!
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-6">
                            <!-- DEPARTURE DATETIME -->
                            <h6 class="text-primary-accent text-start"> Departure Datetime
                                <span class="text-danger fw-bolder"> * </span>
                            </h6>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fa-solid fa-clock"></i>
                                </div>

                                <input id="edit-d-datetime" name="edit-d-datetime"
                                       class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                                       type="datetime-local" data-group="edit-flight">

                                <div class="invalid-feedback text-start">
                                    This airport destination field is required!
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <!-- ARRIVAL DATETIME -->
                            <h6 class="text-primary-accent text-start"> Arrival Datetime
                                <span class="text-danger fw-bolder"> * </span>
                            </h6>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fa-solid fa-clock"></i>
                                </div>

                                <input id="edit-a-datetime" name="edit-a-datetime"
                                       class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                                       type="datetime-local" data-group="edit-flight">

                                <div class="invalid-feedback text-start">
                                    This airport destination field is required!
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex modal-footer bg-light">
                    <button class="btn btn-success text-white" type="submit">
                        Save
                    </button>

                    <button class="btn btn-danger text-white" data-bs-dismiss="modal" type="reset">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE FLIGHT MODAL -->
<div class="modal fade" id="delete-flight" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm modal-dialog-centered text-center">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h2 class="modal-title fs-5"> Are you sure? </h2>
            </div>

            <div class="d-flex modal-footer bg-light">
                <button class="btn btn-success text-white" data-bs-dismiss="modal">
                    No
                </button>

                <form onsubmit="deleteFlight(event)">
                    <button class="btn btn-danger text-white">
                        Yes, Delete It
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

