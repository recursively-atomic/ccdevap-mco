{{> navigation}}

<div class="container mt-5 mb-5">
    <!-- TABS -->
    <ul class="row-gap-3 nav nav-tabs nav-fill border-0 column-gap-3">
        <li class="nav-item">
            <button class="nav-link active" id="profile-information-tab" data-bs-toggle="tab"
                    data-bs-target="#profile-information-pane">
                Profile Information
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" id="passenger-information-tab" data-bs-toggle="tab"
                    data-bs-target="#passenger-information-pane">
                Passenger Information
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" id="saved-passengers-tab" data-bs-toggle="tab"
                    data-bs-target="#saved-passengers-pane">
                Saved Passengers
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" id="payment-information-tab" data-bs-toggle="tab"
                    data-bs-target="#payment-information-pane">
                Payment Information
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" id="notification-preferences-tab" data-bs-toggle="tab"
                    data-bs-target="#notification-preferences-pane">
                Notification Preferences
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" id="travel-history-tab" data-bs-toggle="tab" data-bs-target="#travel-history-pane">
                Travel History
            </button>
        </li>
    </ul>

    <!-- TAB CONTENTS -->
    <div class="px-4 pt-3 bg-white border-start border-end border-bottom border-top rounded-3 border-white
         rounded-top-0 tab-content">

        <!-- PROFILE INFORMATION TAB -->
        <div class="tab-pane fade show active" id="profile-information-pane">
            <!-- PROFILE PICTURE AND INFORMATION -->
            <div class="m-4">
                <div class="row d-flex align-items-center">
                    <div class="col-lg-3 col-md-4 col-sm-12 card-hover position-relative">
                        <img class="d-block rounded-3 shadow-lg img-fluid"
                             src="https://picsum.photos/1280/1280?random=1" id="profile-picture">

                        <button class="mb-3 btn btn-sm btn-tertiary bottom-0 position-absolute start-50 translate-middle-x text-black text-nowrap"
                                onclick="$('#change-profile').click();">
                            Change Profile
                        </button>

                        <input class="d-none" type="file" accept="image/*" id="change-profile">
                    </div>

                    <div class="col-lg-9 col-md-8 col-sm-12 mt-sm-3 mt-3 text-dark">
                        <p class="m-0 p-0 fs-1 fw-bolder" id="profile-name" data-first-name="{{user.firstName}}"
                           data-last-name="{{user.lastName}}">
                            {{user.lastName}}, {{user.firstName}}
                        </p>

                        <div class="d-flex m-0 align-items-center">
                            <h4 class="m-0 p-0 pe-1"> E-Mail: </h4>
                            <p id="profile-email" class="m-0 p-0 fs-4"> {{user.emailAddress}} </p>
                        </div>

                        <div class="d-flex m-0 align-items-center">
                            <h4 class="m-0 p-0 pe-1"> Contact Number: </h4>

                            <p id="profile-contact" class="m-0 p-0 fs-4">
                                {{user.contactNumber}}
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="border border-3 border-dark rounded-3 opacity-100">

            <!-- PROFILE UPDATE OPTIONS -->
            <div class="m-4 mb-0">
                <div class="row text-black">
                    <div class="col-lg-6 col-md-6 mb-sm-4 mb-4 mb-lg-4">
                        <h4 class="text-primary-accent"> Current Password
                            <span class="text-danger fw-bolder"> * </span>
                        </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary fa-solid fa-lock-open"></i>
                            </div>

                            <input id="current-password"
                                   class="form-control bg-light border-dark border-2 text-black required-field"
                                   type="password" placeholder="Current Password" data-group="update-password"
                                   data-password="{{user.password}}">

                            <button type="button"
                                    class="input-group-text bg-dark border-dark border-2 rounded-end-3 toggle-password">
                                <i class="text-secondary fa-solid fa-eye" data-target="#current-password"></i>
                            </button>

                            <div class="invalid-feedback">
                                This password field is required!
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 mb-md-4 mb-sm-4 mb-4 mb-lg-4">
                        <h4 class="text-primary-accent"> New Password
                            <span class="text-danger fw-bolder"> * </span>
                        </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary fa-solid fa-lock"></i>
                            </div>

                            <input id="new-password"
                                   class="form-control bg-light border-dark border-2 text-black required-field"
                                   type="password" placeholder="New Password" data-group="update-password">

                            <button type="button"
                                    class="input-group-text bg-dark border-dark border-2 rounded-end-3 toggle-password">
                                <i class="text-secondary fa-solid fa-eye" data-target="#new-password"></i>
                            </button>

                            <div id="password-no-input" class="invalid-feedback">
                                This password field is required!
                            </div>

                            <div id="password-invalid-input" class="invalid-feedback">
                                An password must be at least 8 characters, and has at least 1 uppercase, lowercase,
                                number and special character!
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex mb-4 gap-2 justify-content-center">
                <button id="save-password" class="btn btn-lg btn-primary text-white">
                    Save Changes
                </button>

                <button class="btn btn-lg btn-secondary text-white" onclick="showEditModal()" data-bs-toggle="modal"
                        data-bs-target="#update-profile">
                    Update Profile Information
                </button>
            </div>

            <!-- UPDATE PROFILE MODAL -->
            <div id="update-profile" class="modal fade" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-dark text-white">
                            <h5 class="modal-title">
                                Update Profile Information
                            </h5>
                        </div>

                        <div class="modal-body">
                            <input type="hidden" id="profile-user-id">

                            <h4 class="text-primary-accent"> First Name
                                <span class="text-danger fw-bolder"> * </span>
                            </h4>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary bi bi-chat-square-dots-fill"></i>
                                </div>

                                <input id="edit-first-name"
                                       class="form-control bg-light border-dark border-2 text-black rounded-end-3 required-field"
                                       type="text" placeholder="Enter Updated First Name" data-group="edit-profile">

                                <div class="invalid-feedback text-start">
                                    This first name field is required!
                                </div>
                            </div>

                            <h4 class="text-primary-accent"> Last Name
                                <span class="text-danger fw-bolder"> * </span>
                            </h4>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary bi bi-chat-square-dots-fill"></i>
                                </div>

                                <input id="edit-last-name"
                                       class="form-control bg-light border-dark border-2 text-black rounded-end-3 required-field"
                                       type="text" placeholder="Enter Updated Last Name" data-group="edit-profile">

                                <div class="invalid-feedback text-start">
                                    This last name field is required!
                                </div>
                            </div>

                            <h4 class="text-primary-accent"> E-Mail Address
                                <span class="text-danger fw-bolder"> * </span>
                            </h4>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fa-solid fa-at"></i>
                                </div>

                                <input id="edit-email-address"
                                       class="form-control bg-light border-dark border-2 text-black required-field rounded-end-3"
                                       type="text" placeholder="email-address@domain.com" data-group="edit-profile">

                                <div id="email-no-input" class="invalid-feedback text-start">
                                    This e-mail field is required!
                                </div>

                                <div id="email-invalid-input" class="invalid-feedback">
                                    An e-mail must have a character before and after @, and a domain!
                                </div>
                            </div>

                            <h4 class="text-primary-accent"> Contact Number </h4>

                            <div class="mb-3 input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary bi bi-telephone-fill"></i>
                                </div>

                                <input id="edit-phone-code"
                                       class="form-control bg-light border-dark border-end-0 border-2 text-black"
                                       type="text" placeholder="00">
                                <input id="edit-phone-number"
                                       class="form-control w-50 bg-light border-dark border-2 text-black" type="text"
                                       placeholder="123456789">
                            </div>
                        </div>

                        <div class="d-flex modal-footer bg-light">
                            <button id="save-profile" class="btn btn-success text-white" type="button">
                                Save
                            </button>

                            <button class="btn btn-danger text-white" data-bs-dismiss="modal" type="reset">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PASSENGER INFORMATION TAB -->
        <div class="tab-pane fade" id="passenger-information-pane">
            <!-- PASSPORT INFORMATION SECTION -->
            <h2 class="text-primary"> Passport Information </h2>

            <hr class="border border-3 border-dark rounded-3 opacity-100">

            <div class="m-4">
                <div class="row">
                    <div class="col-lg-4 col-md-4 mb-sm-4 mb-4">
                        <h4 class="text-primary-accent"> Country Code </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-map-fill"></i>
                            </div>

                            <input id="country-code" class="form-control bg-light border-dark border-2 text-black"
                                   type="text" placeholder="AAA">
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 mb-sm-4 mb-4">
                        <h4 class="text-primary-accent"> Passport Code </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-postcard-fill"></i>
                            </div>

                            <input id="passport-code" class="form-control bg-light border-dark border-2 text-black"
                                   type="text" placeholder="A12345678">
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4">
                        <h4 class="text-primary-accent"> Expiration Date </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-calendar2-fill"></i>
                            </div>

                            <input id="passport-expiration"
                                   class="form-control rounded-end-3 bg-light border-dark border-2 text-black"
                                   type="date">
                        </div>
                    </div>
                </div>
            </div>

            <!-- PERSONAL INFORMATION SECTION -->
            <h2 class="text-primary"> Personal Information </h2>

            <hr class="border border-3 border-dark rounded-3 opacity-100">

            <!-- PASSENGER NAME -->
            <div class="m-4">
                <h4 class="text-primary-accent"> Name </h4>

                <div class="row">
                    <div class="col-lg-4 col-md-6 mb-sm-4 mb-4">
                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-chat-square-dots-fill"></i>
                            </div>

                            <input id="first-name" name="firstName"
                                   class="form-control rounded-end-3 bg-light border-dark border-2 text-black"
                                   type="text" value="{{user.firstName}}">
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6 mb-md-4 mb-sm-4 mb-4">
                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-chat-square-dots-fill"></i>
                            </div>

                            <input id="last-name" name="lastName"
                                   class="form-control rounded-end-3 bg-light border-dark border-2 text-black"
                                   type="text" value="{{user.lastName}}">
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-pen-fill"></i>
                            </div>

                            <select id="suffix" class="form-select bg-light border-dark border-2 text-black">
                                <option selected hidden value=""> Select A Suffix </option>
                                <option> None </option>
                                <option> Jr. </option>
                                <option> Sr. </option>
                                <option> II </option>
                                <option> III </option>
                                <option> IV </option>
                                <option> V </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BIRTHDATE -->
            <div class="mx-4 mb-4">
                <h4 class="text-primary-accent"> Birthdate </h4>

                <div class="row align-items-center">
                    <div class="col-lg-12 col-mid-12 col-sm-12 col-12" id="date-container">
                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-calendar2-fill"></i>
                            </div>

                            <input class="form-control rounded-end-3 bg-light border-dark border-2 text-black"
                                   type="date" id="date-input">

                            <div class="invalid-feedback">
                                Select a date before or on today!
                            </div>
                        </div>
                    </div>

                    <div class="d-none" id="age-badge-container">
                        <span class="p-2 badge card-hover rounded-pill text-bg-primary text-white shadow"
                              id="age-badge"></span>
                    </div>
                </div>
            </div>

            <div class="mx-4 mb-4">
                <div class="row">
                    <div class="col-lg-6 col-md-6 mb-sm-4 mb-4">
                        <!-- GENDER -->
                        <h4 class="text-primary-accent"> Gender </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-person-fill"></i>
                            </div>

                            <select id="gender-select" class="form-select bg-light border-dark border-2 text-black">
                                <option selected hidden> Select Gender </option>
                                <option> Prefer Not To Answer </option>
                                <option> Not Listed </option>
                                <option> Male </option>
                                <option> Female </option>
                                <option> Transgender Male </option>
                                <option> Transgender Female </option>
                                <option> Non-Binary </option>
                            </select>
                        </div>

                        <div class="d-none mt-4" id="other-gender-container">
                            <input class="form-control bg-light border-dark text-black" type="text"
                                   placeholder="Please Specify" id="other-gender-input">
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <!-- NATIONALITY -->
                        <h4 class="text-primary-accent"> Nationality </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-flag-fill"></i>
                            </div>

                            <select id="nationality" class="form-select bg-light border-dark border-2 text-black">
                                <option selected hidden> Select A Nationality </option>
                                <option> Afghan </option>
                                <option> Bahamian </option>
                                <option> Cambodian </option>
                                <option> Danish </option>
                                <option> East Timorese </option>
                                <option> Filipino </option>
                                <option> Gabonese </option>
                                <option> Haitian </option>
                                <option> Icelander </option>
                                <option> Jamaican </option>
                                <option> Kazakhstani </option>
                                <option> Laotian </option>
                                <option> Macedonian </option>
                                <option> Namibian </option>
                                <option> Omani </option>
                                <option> Pakistani </option>
                                <option> Qatari </option>
                                <option> Romanian </option>
                                <option> Saint Lucian </option>
                                <option> Taiwanese </option>
                                <option> Ugandan </option>
                                <option> Venezuelan </option>
                                <option> Welsh </option>
                                <option> Yemenite </option>
                                <option> Zambian </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CONTACT INFORMATION TAB -->
            <h2 class="text-primary"> Contact Information </h2>

            <hr class="border border-3 border-dark rounded-3 opacity-100">

            <div class="m-4">
                <div class="row">
                    <div class="col-lg-6 col-md-12 mb-md-4 mb-sm-4 mb-4 mb-lg-0">
                        <!-- E-MAIL -->
                        <h4 class="text-primary-accent"> E-Mail Address </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary fa-solid fa-at"></i>
                            </div>

                            <input id="email-address" class="form-control bg-light border-dark border-2 text-black"
                                   type="text" placeholder="email-address@domain.com">
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12 mb-0">
                        <!-- PHONE NUMBER -->
                        <h4 class="text-primary-accent"> Phone Number </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary bi bi-telephone-fill"></i>
                            </div>

                            <input id="phone-code"
                                   class="form-control bg-light border-dark border-end-0 border-2 text-black"
                                   type="text" placeholder="00">
                            <input id="phone-number" class="form-control w-50 bg-light border-dark border-2 text-black"
                                   type="text" placeholder="123456789">
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4 text-center">
                <button id="save-passenger" class="btn btn-lg btn-primary text-white"
                        onclick="showToast('success-toast', 'Successfully saved passenger [NAME]!')">
                    Save Passenger
                </button>
            </div>
        </div>

        <!-- SAVED PASSENGERS TAB -->
        <div class="tab-pane fade" id="saved-passengers-pane">
            <h2 class="p-5 text-primary text-center"> No Saved Passengers </h2>

            <!-- DELETE PASSENGER MODAL -->
            <div class="modal fade" data-bs-backdrop="static" id="delete-passenger">
                <div class="modal-dialog modal-sm modal-dialog-centered text-center">
                    <div class="modal-content">
                        <div class="modal-header bg-dark text-white">
                            <h2 class="modal-title fs-5"> Are you sure? </h2>
                        </div>

                        <div class="d-flex modal-footer bg-light">
                            <button class="btn btn-success text-white" data-bs-dismiss="modal">
                                No
                            </button>

                            <button class="btn btn-danger text-white" data-bs-dismiss="modal">
                                Yes, Delete It
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PAYMENT INFORMATION TAB -->
        <div class="tab-pane fade" id="payment-information-pane">
            <h2 class="text-primary"> Payment Method </h2>

            <hr class="border border-3 border-dark rounded-3 opacity-100">

            <div class="container">
                <div class="m-4">
                    <div class="col-lg-6 col-md-6 col-sm-12">
                        <h4 class="text-primary-accent"> Method </h4>

                        <div class="input-group">
                            <div class="input-group-text bg-dark border-dark">
                                <i class="text-secondary fa-solid fa-wallet"></i>
                            </div>

                            <select id="payment-method-select"
                                    class="form-select bg-light border-dark border-2 text-black">
                                <option selected hidden> Select A Payment Method </option>
                                <option> Cash </option>
                                <option> Credit Card </option>
                                <option> Debit Card </option>
                                <option> Digital Wallet </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- INPUT FIELDS FOR CREDIT OR DEBIT CARD -->
            <div class="container d-none m-0 px-0" id="card-input-fields">
                <h2 class="text-primary"> Account Information </h2>

                <hr class="border border-3 border-dark rounded-3 opacity-100">

                <div class="m-4 px-3">
                    <div class="row">
                        <div class="col-lg-6 col-md-12 mb-md-4 mb-sm-4 mb-4">
                            <h4 class="text-primary-accent"> Cardholder </h4>

                            <div class="input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary bi bi-credit-card-2-front-fill"></i>
                                </div>

                                <input id="card-first-name"
                                       class="form-control bg-light border-dark border-2 border-end-0 text-black"
                                       type="text" placeholder="Brook Remi">
                                <input id="card-last-name" class="form-control bg-light border-dark border-2 text-black"
                                       type="text" placeholder="Doe">
                            </div>
                        </div>

                        <div class="col-lg-6 col-md-12">
                            <h4 class="text-primary-accent"> Send E-Receipts At E-Mail </h4>

                            <div class="input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fa-solid fa-at"></i>
                                </div>

                                <input id="receipt-email-name"
                                       class="form-control bg-light border-dark border-2 text-black" type="text"
                                       placeholder="email-address@domain.com">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="m-4 px-3">
                    <div class="row">
                        <div class="col-lg-4 col-md-6 mb-md-4 mb-sm-4 mb-4">
                            <h4 class="text-primary-accent"> Country </h4>

                            <div class="input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary bi bi-globe-central-south-asia"></i>
                                </div>

                                <select id="billing-country"
                                        class="form-select bg-light border-dark border-2 text-black">
                                    <option selected hidden value=""> Select A Country </option>
                                    <option> Afghanistan </option>
                                    <option> Bahamas </option>
                                    <option> Cambodia </option>
                                    <option> Denmark </option>
                                    <option> Gabon </option>
                                    <option> Haiti </option>
                                    <option> Iceland </option>
                                    <option> Jamaica </option>
                                    <option> Kazakhstan </option>
                                    <option> Laos </option>
                                    <option> Namibia </option>
                                    <option> North Macedonia </option>
                                    <option> Oman </option>
                                    <option> Pakistan </option>
                                    <option> Philippines </option>
                                    <option> Qatar </option>
                                    <option> Romania </option>
                                    <option> Saint Lucia </option>
                                    <option> Taiwan </option>
                                    <option> Timor-Leste </option>
                                    <option> Uganda </option>
                                    <option> United Kingdom </option>
                                    <option> Venezuela </option>
                                    <option> Yemen </option>
                                    <option> Zambia </option>
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-6 mb-sm-4 mb-4">
                            <h4 class="text-primary-accent"> Region </h4>

                            <div class="input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary fa-solid fa-location-dot"></i>
                                </div>

                                <input id="billing-region" class="form-control bg-light border-dark border-2 text-black"
                                       type="text" placeholder="Province Town">
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <h4 class="text-primary-accent"> ZIP Code </h4>

                            <div class="input-group">
                                <div class="input-group-text bg-dark border-dark">
                                    <i class="text-secondary bi bi-inboxes-fill"></i>
                                </div>

                                <input id="zip-code" class="form-control bg-light border-dark border-2 text-black"
                                       type="text" placeholder="1AA1">
                            </div>
                        </div>
                    </div>
                </div>

