{{#each flightCards}}
    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card bg-primary-accent card-hover-sm p-2 shadow">
            <div class="d-flex justify-content-between">
                <img class="img-thumbnail bg-dark border-dark m-0 p-0 square-40px" {{#if (eq
                     this.airline 'Cebu Atlantic' )}} src="/media/images/cebu-atlantic.png" {{else if (eq
                     this.airline 'Filipino Airlines' )}} src="/media/images/filipino-airlines.png" {{else if (eq
                     this.airline 'AirFAST' )}} src="/media/images/airfast.png" {{else if (eq this.airline 'Sunray Air'
                     )}} src="/media/images/sunray-air.png" {{/if}}>

                <h4 class="fw-bold mt-1 m-0 p-0 text-light"> PHP {{formatNumber this.baseFare}} </h4>
            </div>

            <hr class="border border-3 border-tertiary-accent rounded-3 opacity-100 m-0 my-2">

            <h4 class="d-flex align-items-center m-0 mb-2 text-secondary fw-bolder">
                <i class="fa-solid fa-plane me-2 p-0"></i>

                <p class="m-0 p-0">
                    {{#if (eq this.airline 'Cebu Atlantic')}} CA
                    {{else if (eq this.airline 'Filipino Airlines')}} FA
                    {{else if (eq this.airline 'AirFAST')}} AF
                    {{else if (eq this.airline 'Sunray Air')}} SA {{/if}}

                    {{pad this.flightNumber 4 '0'}}
                </p>
            </h4>

            <h6 class="d-flex align-items-center m-0 text-tertiary fw-bolder">
                <i class="fa-solid fa-hourglass-start fa-sm me-1"></i>
                <p class="m-0 p-0 me-1"> {{getTime this.departureDatetime}} - {{getTime this.arrivalDatetime}} </p>
                <p class="m-0 p-0"> ( </p>
                <p class="m-0 p-0"> {{getDuration this.departureDatetime this.arrivalDatetime}} </p>
                <p class="m-0 p-0"> ) </p>
            </h6>

            <h6 class="d-flex align-items-center m-0 text-tertiary fw-bolder">
                <i class="bi bi-stoplights-fill me-2 p-0"></i>
                <p class="m-0 p-0"> No Layovers </p>
            </h6>

            <hr class="border border-3 border-tertiary-accent rounded-3 opacity-100 m-0 my-2">

            <button class="btn btn-lg btn-primary border-4 text-white m-0 mb-2"
                    onclick="continueBooking({{this.flightNumber}})">

                <p class="m-0 p-0 fw-bolder"> Book </p>
                <h6 class="m-0 p-0 text-light"> ({{this.availableSeats}}/16 Seats) </h6>
            </button>

            <button class="btn btn-lg btn-secondary border-4 text-white m-0"
                    onclick="showViewModal('{{this.flightNumber}}')" data-bs-toggle="modal"
                    data-bs-target="#view-flight">

                <p class="m-0 p-0 fw-bolder"> View Details </p>
            </button>
        </div>
    </div>
{{else}}
    <h2 class="text-primary text-center p-5 m-0"> No Flights Found </h2>
{{/each}}