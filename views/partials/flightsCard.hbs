{{#with flightsCard}}
    <div class="d-flex card shadow-lg">
        <div class="card-header text-center text-white bg-primary-accent">
            <h2 class="mt-2"> Flight Management </h2>
        </div>

        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover text-center">
                    <thead class="border-dark border-2">
                        <th class="text-secondary bg-dark" scope="col">
                            Flight Number
                        </th>

                        <th class="text-secondary bg-dark" scope="col">
                            Origin
                        </th>

                        <th class="text-secondary bg-dark" scope="col">
                            Destination
                        </th>

                        <th class="text-secondary bg-dark" scope="col">
                            Departure
                        </th>

                        <th class="text-secondary bg-dark" scope="col">
                            Arrival
                        </th>

                        <th class="text-secondary bg-dark" scope="col">
                            Base Fare
                        </th>

                        <th class="text-secondary bg-dark" scope="col">
                            Flight Status
                        </th>

                        <th class="text-secondary bg-dark" scope="col">
                            Capacity Status
                        </th>

                        <th class="text-secondary bg-dark" scope="col">
                            Details
                        </th>
                    </thead>

                    <tbody class="table-group-divider">
                        {{> flightRows}}
                        <tr class="border-3 border-bottom-0 border-top border-end-0 border-start-0 border-dark"></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-primary-accent">
            <div class="d-flex flex-wrap gap-3 m-3 justify-content-between align-items-center">
                <h6 class="text-white">
                    Showing {{pagination.resultsPerPage}} Results Out Of {{pagination.totalResults}}
                </h6>

                <div class="d-flex flex-wrap gap-3 justify-content-center align-items-center">
                    <button class="m-0 btn btn-success text-white" data-bs-toggle="modal" data-bs-target="#add-flight">
                        Add Flight
                    </button>

                    {{> pagination}}
                </div>
            </div>
        </div>
    </div>
{{/with}}