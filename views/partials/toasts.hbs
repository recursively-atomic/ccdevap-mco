<div id="toast-container" class="d-flex flex-column p-0 m-0 gap-1 mb-3 toast-container position-fixed bottom-0 start-50 translate-middle-x align-items-center">
    <!-- DANGER TOAST TEMPLATE -->
    <div id="danger-toast" class="p-3 mb-0 toast w-auto text-bg-danger text-white z-max">
        <div class="d-flex align-items-center">
            <div class="toast-body fw-bold text-nowrap"></div>
            <button class="me-2 m-auto btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
    </div>

    <!-- SUCCESS TOAST TEMPLATE -->
    <div id="success-toast" class="p-3 mb-0 toast w-auto text-bg-success text-white">
        <div class=" d-flex align-items-center">
            <div class="toast-body fw-bold text-nowrap"></div>
            <button class="me-2 m-auto btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
    </div>

    <!-- WARNING TOAST TEMPLATE -->
    <div id="warning-toast" class="p-3 mb-0 toast w-auto text-bg-warning text-white">
        <div class=" d-flex align-items-center">
            <div class="toast-body fw-bold text-nowrap"></div>
            <button class="me-2 m-auto btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>