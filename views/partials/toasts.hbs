<div id="toast-container" class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-0 m-0 align-items-center d-flex flex-column gap-1 mb-3">
    <!-- DANGER TOAST TEMPLATE -->
    <div id="danger-toast" class="toast p-3 mb-0 w-auto text-bg-danger text-white z-max">
        <div class="d-flex align-items-center">
            <div class="text-nowrap toast-body"></div>
            <button class="me-2 m-auto btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
    </div>

    <!-- SUCCESS TOAST TEMPLATE -->
    <div id="success-toast" class="toast p-3 mb-0 w-auto text-bg-success text-white">
        <div class=" d-flex align-items-center">
            <div class="text-nowrap toast-body"></div>
            <button class="me-2 m-auto btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
    </div>

    <!-- WARNING TOAST TEMPLATE -->
    <div id="warning-toast" class="toast p-3 mb-0 w-auto text-bg-warning text-white">
        <div class=" d-flex align-items-center">
            <div class="text-nowrap toast-body"></div>
            <button class="me-2 m-auto btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>