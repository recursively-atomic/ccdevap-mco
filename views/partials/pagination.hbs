{{#if (gt pagination.totalPages 1)}}
    <nav>
        <ul class="m-0 pagination">
            <li class="page-item">
                <a class="page-link {{#if (eq pagination.currentPage 1)}}disabled{{/if}}"
                   {{#if (gt pagination.currentPage 1)}} href="{{pagination.baseUrl}}1"{{/if}}>
                    <span> &laquo; </span>
                </a>
            </li>

            {{#each (range 1 pagination.totalPages)}}
                <!-- Always displays the first and last page buttons, as well as 2 pages before and after the page the user is in -->
                {{#if (or (eq this 1) (eq this ../pagination.totalPages) (and (gte this (subtract ../pagination.currentPage 2)) (lte this (add ../pagination.currentPage 2))))}}
                    {{#if (eq this ../pagination.currentPage)}}
                        <li class="page-item">
                            <a class="page-link active"> {{this}} </a>
                        </li>
                    {{else}}
                        <li class="page-item">
                            <a class="page-link" href="{{../pagination.baseUrl}}{{this}}"> {{this}} </a>
                        </li>
                    {{/if}}
                <!-- The page buttons meant for 3 pages before and after the page the user is in, will display an elipsis to represent the other page buttons not displayed -->
                {{else}}
                    {{#if (or (eq this (add ../pagination.currentPage 3)) (eq this (subtract ../pagination.currentPage 3)))}}
                        <li class="page-item">
                            <a class="page-link disabled"> … </a>
                        </li>
                    {{/if}}
                {{/if}}
            {{/each}}

            <li class="page-item">
                <a class="page-link {{#if (eq pagination.currentPage pagination.totalPages)}}disabled{{/if}}"
                   {{#if (lt pagination.currentPage pagination.totalPages)}} href="{{pagination.baseUrl}}{{pagination.totalPages}}"{{/if}}>
                    <span aria-hidden="true"> &raquo; </span>
                </a>
            </li>
        </ul>
    </nav>
{{/if}}